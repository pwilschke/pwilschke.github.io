# Quarto
/.quarto/
*_files/
*_cache/

# LaTeX build artifacts from cv/. cv.tex and citations.bib are tracked;
# cv/cv.pdf is not -- the published copy is the one at the repo root.
cv/*.aux
cv/*.bbl
cv/*.bcf
cv/*.blg
cv/*.fdb_latexmk
cv/*.fls
cv/*.log
cv/*.out
cv/*.run.xml
cv/*.synctex.gz
cv/*.toc
cv/cv.pdf

# Camera original for the headshot. assets/headshot.jpg is generated from it
# (square crop, resized, EXIF stripped) and is the file the site actually uses,
# so there is no reason to publish a 645KB HEIC the browser cannot display.
*.heic
*.HEIC

# Debug output of tools/make_headshot.py --preview
assets/headshot-preview.png

# OS
.DS_Store
Thumbs.db
desktop.ini

# NOTE: docs/ is deliberately NOT ignored. GitHub Pages serves the site from
# that folder, so the rendered output must be committed. Same for the root
# cv.pdf, which is the file the site links to.
